# Copy to .env (local dev) or .env.production (docker compose). Never commit real values.
APP_ENV=dev
# 32+ random bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-32-bytes-min
PARENT_PASSWORD=change-me
# Optional: require a one-time password per device before the child picker shows.
HOUSEHOLD_PASSWORD=
TIMEZONE=America/Los_Angeles
DATABASE_URL=sqlite:///./data/discito.db
WHISPER_URL=http://localhost:9000
# Dev only: show a "type what you said" box so the recite flow works without a mic/whisper.
STT_TYPED_FALLBACK=1
# Sidecar
WHISPER_MODEL=small.en
